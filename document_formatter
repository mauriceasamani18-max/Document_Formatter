"""
Smart Document Formatter
-----------------------
A Windows-friendly desktop application for applying predefined formatting
presets to existing Microsoft Word (.docx) documents.

Requirements:
    pip install python-docx

Run:
    python smart_document_formatter.py

Notes:
- The original file is never overwritten; output is saved separately.
- The program formats existing paragraphs and tables. It does not rewrite text.
- Existing images, tables, hyperlinks, headers, footers and section breaks are
  generally retained, but complex layouts should always be checked afterwards.
- Citation/reference formatting is a layout aid, not a citation validator.
"""

from __future__ import annotations

import os
import re
import shutil
import tkinter as tk
from tkinter import filedialog, messagebox, ttk
from pathlib import Path

try:
    from docx import Document
    from docx.enum.text import WD_ALIGN_PARAGRAPH, WD_BREAK
    from docx.enum.table import WD_TABLE_ALIGNMENT, WD_CELL_VERTICAL_ALIGNMENT
    from docx.shared import Inches, Pt, RGBColor
    from docx.oxml import OxmlElement
    from docx.oxml.ns import qn
except ImportError:
    _root = tk.Tk()
    _root.withdraw()
    messagebox.showerror(
        "Missing dependency",
        "The python-docx package is required.\n\n"
        "Install it with:\n    pip install python-docx"
    )
    raise SystemExit(1)


